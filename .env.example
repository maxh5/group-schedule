# Copy to `.env` and fill in values. Never commit `.env`.

# Flask session signing (required in production)
SECRET_KEY=

# Database (default: sqlite:///dev.db if unset or left blank)
# Omit this line entirely for local SQLite, or use e.g. sqlite:///dev.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# Google OAuth 2.0 (Web application client from Google Cloud Console)
# Enable the Google Calendar API on this project for multi-calendar sync.
# Authorized redirect URI must include: https://<host>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: override redirect URI (defaults to request URL for /auth/google/callback)
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback
